# Copy this file to .env.production or .env.docker and fill in the values.
# .env.development is committed (localhost defaults) — no changes needed for local dev.
#
# Production / Docker:
#   VITE_SERVER_URL — backend API base URL, injected via Docker --build-arg in CI (secrets.VITE_SERVER_URL)
VITE_SERVER_URL=https://your-api-url-here
